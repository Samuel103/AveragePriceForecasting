# Copy to .env in the directory where you launch the app.
# Exported environment variables take precedence over .env.
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# To use Ollama, set MODEL_PROVIDER=ollama and set the exact model tag
# shown by `ollama list` (for example, your installed Gemma model).
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
